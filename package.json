{
  "name": "dsh-annotator",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness 插件：在右侧栏文档预览里对图片、SVG、PDF、HTML、Office 文档直接画标注，标注可保存并填入当前会话",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^26.0.0",
    "lefthook": "^2.1.14",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc --noEmit -p tsconfig.json && tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint . --type-aware --deny-warnings --ignore-pattern 'tests/gates/fixtures/**'",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test:coverage"
  }
}
